# 릴리스 서명 설정. 이 파일을 keystore.properties 로 복사해 채운다(그 파일은 커밋되지 않는다).
#
# 키스토어 만들기 — 한 번만. 만든 .jks 와 아래 비밀번호는 잃어버리면 복구할 수 없고,
# 잃으면 이 앱을 다시는 업데이트할 수 없다. 비밀번호 관리자에 함께 보관할 것.
#
#   keytool -genkeypair -v \
#     -keystore carecode-release.jks \
#     -alias carecode \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# storeFile 은 android/ 기준 상대경로 또는 절대경로.
storeFile=../carecode-release.jks
storePassword=
keyAlias=carecode
keyPassword=
